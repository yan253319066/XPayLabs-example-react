# XPay Labs API Credentials
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Never commit the .env file to version control

# Required: Your XPay Labs API key from the dashboard
REACT_APP_XPAY_API_KEY=your-api-key

# Required: Your XPay Labs API secret from the dashboard
REACT_APP_XPAY_API_SECRET=your-api-secret

# Optional: The base URL for the XPay Labs API (defaults to https://api.xpaylabs.com)
REACT_APP_XPAY_BASE_URL=https://api.xpaylabs.com

# Note: This file is compatible with both Windows and Linux environments
# For Windows, you may need to use the following command to copy this file:
# copy .env.example .env
# 
# For Linux/macOS, use:
# cp .env.example .env
